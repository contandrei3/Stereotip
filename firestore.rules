rules_version = '2';

// The app signs every device in anonymously (no passwords) and members pick
// their name. These rules make sure only sessions created by the app can
// read or write band data; random requests to the database are rejected.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
